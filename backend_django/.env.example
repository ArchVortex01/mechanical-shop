# ==========================================
# MahtoMech Environment Configuration Template
# (Copy this file to .env and fill in real values)
# ==========================================

# Django Core Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_HTTPS=False

# JWT Security
JWT_SECRET=replace-with-a-secure-random-jwt-secret-in-production

# Database Configuration
# Set DB_ENGINE to 'postgresql' for production or 'sqlite' for quick local testing
DB_ENGINE=postgresql
DB_NAME=mahtomech_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
# Or single connection URL (e.g. for Neon, Supabase, Render, AWS RDS):
# DATABASE_URL=postgresql://user:password@hostname:5432/mahtomech_db

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_MOCK_MODE=True

# Email Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="MahtoMech" <no-reply@mahtomech.in>
